<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ngelamar_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="NGELAMAR"
        android:textAllCaps="true"
        android:textColor="@color/widget_text_primary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_active_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/ngelamar_widget_badge_indigo"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="0 Aktif"
        android:textColor="@color/widget_badge_indigo_text"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <!-- 1-Tap Quick Add Action -->
    <LinearLayout
        android:id="@+id/widget_btn_add"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ngelamar_widget_button_background"
        android:gravity="center">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/ngelamar_widget_add_description"
            android:src="@drawable/ic_widget_plus" />
    </LinearLayout>

    <!-- Hidden ids kept for the shared renderer -->
    <LinearLayout
        android:id="@+id/widget_active_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_hero_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_time_badge"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/widget_stage_label"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/widget_company_name"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/widget_position_title"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/widget_location_note"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_kpi_offering_val"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/widget_kpi_response_val"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/widget_action_note"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_btn_empty_add"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>
</LinearLayout>
