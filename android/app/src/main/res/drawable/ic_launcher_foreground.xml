<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground matching AppMascotIcon / splash.
     Fill is drawn first, then the dark stroke — never cover the outline.
     Coordinate space is the 100x100 Flutter canvas, scaled into the 108dp
     adaptive viewport with the 72dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Inner radial highlight over the full adaptive canvas -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="21.6"
                android:gradientRadius="97.2"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <group
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateX="15.12"
        android:translateY="15.12">

        <!-- Soft envelope drop shadow (offset, no blur in vector) -->
        <path
            android:fillColor="#3819191B"
            android:pathData="M26,27 L74,27 A14,14 0 0,1 88,41 L88,69 A14,14 0 0,1 74,83 L26,83 A14,14 0 0,1 12,69 L12,41 A14,14 0 0,1 26,27 Z" />

        <!-- Envelope body: cream fill + dark stroke (same order as Flutter painter) -->
        <path
            android:fillColor="#FAF9F6"
            android:strokeColor="#19191B"
            android:strokeWidth="3.5"
            android:strokeLineJoin="round"
            android:pathData="M26,24 L74,24 A14,14 0 0,1 88,38 L88,66 A14,14 0 0,1 74,80 L26,80 A14,14 0 0,1 12,66 L12,38 A14,14 0 0,1 26,24 Z" />

        <!-- Flap fold line, inset so it never crosses the black stroke -->
        <clip-path android:pathData="M27.8,26.8 L72.2,26.8 A11.2,11.2 0 0,1 85.2,38 L85.2,66 A11.2,11.2 0 0,1 72.2,77.2 L27.8,77.2 A11.2,11.2 0 0,1 14.8,66 L14.8,38 A11.2,11.2 0 0,1 27.8,26.8 Z" />
        <path
            android:strokeColor="#E2DBD0"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M24,32 L50,53 L76,32" />

        <!-- Left sparkling eye -->
        <path
            android:fillColor="#19191B"
            android:pathData="M41.5,51 A5.5,5.5 0 1,1 30.5,51 A5.5,5.5 0 1,1 41.5,51 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M36.2,49.2 A2,2 0 1,1 32.2,49.2 A2,2 0 1,1 36.2,49.2 Z" />

        <!-- Right joyful wink -->
        <path
            android:strokeColor="#19191B"
            android:strokeWidth="3.0"
            android:strokeLineCap="round"
            android:pathData="M60,52 Q64,45 68,52" />

        <!-- Rosy cheeks -->
        <path
            android:fillColor="#A6FF8A80"
            android:pathData="M25.5,58 A4.5,2.5 0 1,1 34.5,58 A4.5,2.5 0 1,1 25.5,58 Z M65.5,58 A4.5,2.5 0 1,1 74.5,58 A4.5,2.5 0 1,1 65.5,58 Z" />

        <!-- Cute smile -->
        <path
            android:strokeColor="#19191B"
            android:strokeWidth="2.6"
            android:strokeLineCap="round"
            android:pathData="M48,57 Q50,61 52,57" />

        <!-- Peek waving glove hand -->
        <path
            android:fillColor="#FAF9F6"
            android:strokeColor="#19191B"
            android:strokeWidth="2.5"
            android:pathData="M91,40 A5,5 0 1,1 81,40 A5,5 0 1,1 91,40 Z" />
    </group>
</vector>
